
<div class="container my-4">
  <h2>Client Status Update Survey</h2>

  <p class="text-muted">
    Please complete the following survey to provide
    feedback about your student team's progress.
  </p>

  <div class="border rounded overflow-hidden">
    <iframe
      src="https://memphis.co1.qualtrics.com/jfe/form/SV_3aSRDvcARz4BKsK"
      title="TAG'em Up Client Status Update Survey"
      width="100%"
      height="900"
      style="border: 0;"
      loading="lazy">
    </iframe>
  </div>

  <p class="mt-3">
    Having trouble viewing the survey?
    <%= link_to "Open survey in a new tab",
      "https://memphis.co1.qualtrics.com/jfe/form/SV_3aSRDvcARz4BKsK",
      target: "_blank",
      rel: "noopener noreferrer" %>
  </p>
</div>
