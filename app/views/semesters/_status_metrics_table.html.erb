<!-- TABLE -->
<div class="table-responsive team-status-table-wrap">

  <div class="status-card-layout">

    <% sprint_list.each do |sprint| %>
      <% sprint_key = sprint.parameterize %>

      <div class="sprint-group <%= sprint_key %>">

        <% teams.each do |team| %>
          <% team_metric = team_sprint_metrics.dig(team.id, sprint) || {} %>

          <div class="card mb-4">
            <div class="card-header">
              <strong><%= team.name %></strong>
            </div>

            <div class="card-body">

              <div class="stage-layout" data-card-stage="planning">
                <h6 class="fw-bold mb-2">Team Evaluation</h6>

                <div class="table-responsive mb-4">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Feature Selection &amp; Decomposition</th>
                        <th>Feature Assignments</th>
                        <th>Kanban Updates</th>
                      </tr>
                    </thead>

                    <tbody>
                      <tr>
                        <td>
                          B: <%= team_metric[:backlog_cards] || 0 %> ·
                          T: <%= team_metric[:todo_cards] || 0 %> ·
                          IP: <%= team_metric[:in_progress_cards] || 0 %> ·
                          D: <%= team_metric[:done_cards] || 0 %>
                        </td>

                        <td>
                          <%= team.students.sum { |student|
                            status_metrics.dig(
                              team.id,
                              student.id,
                              sprint,
                              :fa,
                              :assigned_cards
                            ).to_i
                          } %>
                        </td>

                        <td>
                          <% if team_metric[:ku_band] == "No Data" %>
                            <span class="text-muted">No data available</span>
                          <% else %>
                            <%= team_metric[:ku_score] %>
                            (<%= team_metric[:ku_band] %>)
                          <% end %>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <h6 class="fw-bold mb-2">Individual Evaluation</h6>

                <div class="table-responsive">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Member</th>
                        <th>Time Estimate</th>
                      </tr>
                    </thead>

                    <tbody>
                      <% team.students.each do |student| %>
                        <% metric = status_metrics.dig(team.id, student.id, sprint) || {} %>

                        <tr>
                          <td>
                            <%= "#{student.name.split.first} #{student.name.split.last&.first}." %>
                          </td>

                          <td>
                            <%= metric.dig(:te, :estimated_hours) || 0 %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="stage-layout" data-card-stage="progress">

                <h6 class="fw-bold mb-2">Team Evaluation</h6>

                <div class="table-responsive mb-4">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Client Communication</th>
                        <th>Status &amp; Reflection</th>
                      </tr>
                    </thead>

                    <tbody>
                      <tr>
                        <td>
                          <% client_score = @sponsor_scores_by_team.dig(team.name, sprint) %>

                          <% if client_score.nil? %>
                            <span class="text-muted">No data available</span>
                          <% else %>
                            <%= client_score %>
                          <% end %>
                        </td>
                        <td class="text-muted">No data available</td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <h6 class="fw-bold mb-2">Individual Evaluation</h6>

                <div class="table-responsive">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Member</th>
                        <th>Time Spent</th>
                        <th>Product Progress</th>
                        <th>Code Contribution &amp; Source Control</th>
                      </tr>
                    </thead>

                    <tbody>
                      <% team.students.each do |student| %>
                        <% metric = status_metrics.dig(team.id, student.id, sprint) || {} %>
                        <% done_count = metric.dig(:fsd, :done).to_i %>
                        <% total_count = metric.dig(:fa, :assigned_cards).to_i %>

                        <tr>
                          <td>
                            <%= "#{student.name.split.first} #{student.name.split.last&.first}." %>
                          </td>

                          <td>
                            <%= metric.dig(:ts, :time_spent_hours) || 0 %>
                          </td>

                          <td>
                            <%= metric.dig(:pp, :completion_pct) || 0 %>%
                            (<%= metric.dig(:pp, :band) || "No Data" %>)

                            <div class="github-band">
                              <%= done_count %>/<%= total_count %> done
                            </div>
                          </td>

                          <td>
                            <% if metric.dig(:github, :data_available) %>

                              <div>
                                Commits: <%= metric.dig(:cbp, :commit_count).to_i %>
                              </div>

                              <div>
                                Lines Changed: <%= metric.dig(:cbp, :lines_changed).to_i %>
                              </div>

                              <div>
                                PRs:
                                <%= metric.dig(:pr, :opened_count).to_i %> opened,
                                <%= metric.dig(:pr, :merged_count).to_i %> merged
                              </div>

                              <div>
                                Reviews: <%= metric.dig(:review, :review_count).to_i %>
                              </div>

                              <div class="small text-muted">
                                Last Commit:
                                <%= formatted_last_commit_display(metric) %>
                              </div>

                            <% else %>

                              <span class="text-muted">
                                GitHub data unavailable
                              </span>

                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>

                  </table>
                </div>

              </div>

              <div class="stage-layout" data-card-stage="demo">

                <h6 class="fw-bold mb-2">Team Evaluation</h6>

                <div class="table-responsive mb-4">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Client Communication</th>
                        <th>Demo</th>
                      </tr>
                    </thead>

                    <tbody>
                      <tr>
                        <td>
                          <% client_score = @sponsor_scores_by_team.dig(team.name, sprint) %>

                          <% if client_score.nil? %>
                            <span class="text-muted">No data available</span>
                          <% else %>
                            <%= client_score %>
                          <% end %>
                        </td>
                        <td class="text-muted">No data available</td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <h6 class="fw-bold mb-2">Individual Evaluation</h6>

                <div class="table-responsive">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Member</th>
                        <th>Time Spent</th>
                        <th>Product Progress</th>
                        <th>Product Feedback</th>
                        <th>Code Contribution &amp; Source Control</th>
                        <th>Status &amp; Reflection</th>
                      </tr>
                    </thead>

                    <tbody>
                      <% team.students.each do |student| %>
                        <% metric = status_metrics.dig(team.id, student.id, sprint) || {} %>
                        <% done_count = metric.dig(:fsd, :done).to_i %>
                        <% total_count = metric.dig(:fa, :assigned_cards).to_i %>

                        <tr>
                          <td>
                            <%= "#{student.name.split.first} #{student.name.split.last&.first}." %>
                          </td>

                          <td>
                            <%= metric.dig(:ts, :time_spent_hours) || 0 %>
                          </td>

                          <td>
                            <%= metric.dig(:pp, :completion_pct) || 0 %>%
                            (<%= metric.dig(:pp, :band) || "No Data" %>)

                            <div class="github-band">
                              <%= done_count %>/<%= total_count %> done
                            </div>
                          </td>

                          <td class="text-muted">
                            No data available
                          </td>

                          <td>
                            <% if metric.dig(:github, :data_available) %>

                              <div>
                                Commits: <%= metric.dig(:cbp, :commit_count).to_i %>
                              </div>

                              <div>
                                Lines Changed: <%= metric.dig(:cbp, :lines_changed).to_i %>
                              </div>

                              <div>
                                PRs:
                                <%= metric.dig(:pr, :opened_count).to_i %> opened,
                                <%= metric.dig(:pr, :merged_count).to_i %> merged
                              </div>

                              <div>
                                Reviews: <%= metric.dig(:review, :review_count).to_i %>
                              </div>

                              <div class="small text-muted">
                                Last Commit:
                                <%= formatted_last_commit_display(metric) %>
                              </div>

                            <% else %>

                              <span class="text-muted">
                                GitHub data unavailable
                              </span>

                            <% end %>
                          </td>
                          <td class="text-muted">
                            No data available
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>

              </div>
              
            </div>
          </div>

        <% end %>
        <% if ["Sprint 2", "Sprint 3", "Sprint 4"].include?(sprint) %>
          <% sprint_number = sprint.split.last %>
          <% attached = @sponsor_csv_attached[sprint] %>

          <div class="sponsor-response-section mt-4 pt-3 border-top">
            <h6 class="fw-bold mb-2">Sponsor Response</h6>

            <div
              class="d-flex flex-column gap-2 align-items-center"
              data-sponsor-control="<%= sprint_key %>">

              <%= form_with url: upload_sponsor_csv_semester_path(semester),
                method: :post,
                local: true,
                html: {
                  multipart: true,
                  class: "d-flex gap-2 flex-wrap justify-content-center",
                  data: {
                    sponsor_upload_form: "1",
                    sponsor_sprint_key: sprint_key
                  }
                } do %>

                <%= hidden_field_tag :sprint_number, sprint_number %>

                <%= file_field_tag :sponsor_csv,
                  accept: ".csv",
                  class: "form-control form-control-sm" %>

                <%= submit_tag "Upload",
                  class: "btn btn-ui-primary btn-sm" %>

              <% end %>

              <div
                class="d-flex gap-2 <%= attached ? '' : 'd-none' %>"
                data-sponsor-actions>

                <button
                  type="button"
                  class="btn btn-outline-primary btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#sponsorSummaryModal-<%= sprint_key %>">
                  Summary
                </button>

                <button
                  type="button"
                  class="btn btn-outline-secondary btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#sponsorQuestionsModal-<%= sprint_key %>">
                  Questions
                </button>

              </div>

              <span
                class="text-muted small <%= attached ? 'd-none' : '' %>"
                data-sponsor-upload-hint>
                Upload CSV first
              </span>

              <span
                class="small"
                data-sponsor-upload-feedback>
              </span>

            </div>
          </div>
        <% end %>
      </div>
      
    <% end %>
    
  </div>

</div>
